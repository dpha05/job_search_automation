    {
      "parameters": {
        "jsCode": "const stagePriority = [\n  \"lead\",\n  \"withdrawn\", \n  \"qualified_lead\",\n  \"applied\",\n  \"rejected\",\n  \"pre-screen\",\n  \"interview_1\",\n  \"interview_2\",\n  \"task\",\n  \"interview_3\",\n  \"interview_4\",\n  \"interview_final\",\n  \"offer\"\n];\n\nconst recordsToUpdate = [];\n\nfor (const item of $input.all()) {\n  const rowData = item.json;\n  \n  const currentStage = (rowData.lead_progression || '').toLowerCase();\n  const previousFurthest = (rowData.furthest_stage || '').toLowerCase();\n  \n  const currentRank = stagePriority.indexOf(currentStage);\n  const furthestRank = stagePriority.indexOf(previousFurthest);\n  \n  if (currentRank !== -1 && currentRank > furthestRank) {\n    recordsToUpdate.push({\n      json: {\n        id: rowData.id,\n        new_furthest_stage: rowData.lead_progression,\n        job_title: rowData.job_title,\n        company: rowData.company_name \n      }\n    });\n  }\n}\n\nreturn recordsToUpdate;"
      },
