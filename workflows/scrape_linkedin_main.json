      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const inputPrevious = $input.item.json;\n\nconst keywords = [\n  \"AI engineer\",\n  //\"AI solutions\",\n  \"AI Agent\",\n  //\"AI consultant\",\n  //\"n8n\",\n  \"MLOps\",\n  //\"Automation engineer\"\n];\n\nconst url_keywords = keywords.map(k => encodeURIComponent(k));\n\nreturn {\n  ...inputPrevious,\n  url_keywords \n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4928,
        1248
      ],
      "id": "52e519f0-9f73-438f-984e-4f69993761e2",
      "name": "Set Keywords"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst keywords = item.url_keywords;\n\nconst urlArray = keywords.map(kw => {\n  let workType = \"2\"; \n  \n  if (item.geoId === \"104508036\") {\n    workType = \"2%2C3\"; \n  }\n\n  return `https://www.linkedin.com/jobs/search?keywords=${kw}&geoId=${item.geoId}&f_JT=F%2CC&f_E=3%2C4&f_TPR=${item.publishedAtString}&f_WT=${workType}&position=1&pageNum=0`;\n});\n\nreturn {\n  ...item,\n  urlArray\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4480,
        1248
      ],
      "id": "c215ee19-34b5-453f-804c-7373650ae864",
      "name": "Build URL"
    },
    {
      "parameters": {
        "jsCode": "const timeRange = $input.first().json;\n\nconst countries = [\n\n  { country: \"Germany\", geoId: \"101282230\", group: \"Account_1\" },\n  { country: \"Austria\", geoId: \"103883259\", group: \"Account_1\" },\n  { country: \"Switzerland\", geoId: \"106693272\", group: \"Account_1\" },\n\n  { country: \"Czechia\", geoId: \"104508036\", group: \"Account_2\" },\n  { country: \"Slovakia\", geoId: \"106131491\", group: \"Account_2\" },\n  { country: \"Poland\", geoId: \"105072130\", group: \"Account_2\" },\n\n  { country: \"Sweden\", geoId: \"105117694\", group: \"Account_3\" },\n  { country: \"Norway\", geoId: \"103819153\", group: \"Account_3\" },\n  { country: \"Denmark\", geoId: \"104514075\", group: \"Account_3\" },\n  { country: \"Finland\", geoId: \"100456013\", group: \"Account_3\" },\n\n\n  { country: \"France\", geoId: \"105015875\", group: \"Account_4\" },\n  { country: \"Netherlands\", geoId: \"102890719\", group: \"Account_4\" },\n  { country: \"Belgium\", geoId: \"100565514\", group: \"Account_4\" },\n  { country: \"Luxembourg\", geoId: \"104042105\", group: \"Account_4\" }\n];\n\nreturn countries.map(c => ({\n  ...c,\n  ...timeRange\n}));"
      },
