    {
      "parameters": {
        "jsCode": "const detection = $input.first().json;\n\nconst ACCEPTED_LANGUAGES = ['en', 'cs']; \nconst CONFIDENCE_THRESHOLD = 0.75;     \n\nlet status = 'rejected_language';\nlet detectedLanguage = detection.language || 'unknown';\nlet confidenceScore = detection.score || 0;\n\nconst isCorrectLanguage = ACCEPTED_LANGUAGES.includes(detectedLanguage);\nconst isConfidentEnough = confidenceScore >= CONFIDENCE_THRESHOLD;\n\nif (isCorrectLanguage && isConfidentEnough) {\n    status = 'passed_language';\n}\n\nreturn {\n    status,\n    details: {\n        lang: detectedLanguage,\n        conf: confidenceScore,\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
