    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst tag = item.workflow_tag; \n\nif (tag && tag.includes('_')) {\n  const parts = tag.split('_');\n  const basePlatform = parts[0];\n  const rawCountry = parts[1];\n  \n  item.workflow_tag = basePlatform;\n  \n  if (basePlatform === 'indeed') {\n    item.countryCode = rawCountry;\n  } else if (basePlatform === 'linkedin') {\n    item.country = rawCountry;\n  }\n}\n\nreturn item;"
      },
