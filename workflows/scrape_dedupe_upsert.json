          "jobId": "d2f9dc93-d10e-45b7-9217-32d8ef6a53f9",
          "jobTitle": "IT Automation Engineer",
          "jobUrl": "https://jobs.ashbyhq.com/hilberts/15ac92cf-a46d-49cf-9e31-71a2864229b4",
          "companyName": "Hilbert's AI",
          "companyUrl": "hilberts.ai",
