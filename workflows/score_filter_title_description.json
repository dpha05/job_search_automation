      "parameters": {
        "jsCode": "const items = $('Standardize input').all();\n\nconst hardReject = [\n'director', 'assistant', 'recruiter', 'intern',  'stáž', 'graduate', 'account manager', 'account executive', 'head', 'sales representative', 'ředitel', 'vedoucí', 'legal', 'prodej','seo', 'lead', 'principal', 'staff', 'part-time', 'part time', 'junior', 'fde', 'student', 'sales executive', 'chief', 'research', 'founding',\n\n'java', 'php', 'c++', 'c#', '.net', 'kotlin', 'rust', 'golang', 'ios', 'android', 'swift', 'react native', 'qa automation', 'test automation', 'kubernetes', 'manual tester', 'ruby', 'fullstack', 'full-stack', 'full stack'\n];\n\nreturn items.map(item => {\n  const title = (item.json.job_title || \"\").toLowerCase();\n\n  let newStatus = 'filtered';\n  \n  const isHardReject = hardReject.some(word => title.includes(word));\n  \n  if (isHardReject) {\n    newStatus = 'rejected_title';\n  }\n  else {\n    newStatus = 'passed_title';\n  }\n\n  return {\n    json: {\n      ...item.json,\n      status: newStatus,\n    }\n  };\n});"
      },
