    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst safeWords = [\n  /\\bn8n\\b/i,\n  /\\bSupabase\\b/i,\n  /\\bClay\\s+tables\\b/i,\n  /\\bClay\\.run\\b/i,\n  /\\bZapier\\b/i,\n  /\\bMake\\.com\\b/i\n];\n\nreturn items.map(item => {\n  const description = (item.json.description || \"\");\n  let currentStatus = item.json.status;\n\n  const foundSafeWord = safeWords.some(regex => regex.test(description));\n  \n  if (foundSafeWord) {\n    currentStatus = 'skip_description';\n  }\n\n  return {\n    json: {\n      ...item.json,\n      status: currentStatus,\n      pass_reason: foundSafeWord ? \"VIP Override: High-value tool detected.\" : null\n    }\n  };\n});"
      },
