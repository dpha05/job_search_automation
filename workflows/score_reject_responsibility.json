    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rawCosine = $json.ideal_score_cosine;\n\nconst min = 0.53;\nconst max = 0.67;\n\nlet adjustedCosine = (rawCosine - min) / (max - min);\n\nadjustedCosine = Math.max(0, Math.min(1, adjustedCosine));\n\nconst multipliedCosine = Math.round(adjustedCosine * 100);\n\nreturn  {\n    ideal_score_cosine: adjustedCosine,\n    multipliedCosine\n  }\n;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3152,
        368
