          "jsCode": "const weightedScore = $json.final_weighted_score;\nconst multipliedScore = Math.round(weightedScore * 100);\n\nconst passMin = 0.27;\n\nlet finalDecision = 'rejected_responsibility';\nlet applicationStage = 'withdrawn';\n\nif (weightedScore >= passMin) {\n  finalDecision = 'passed_responsibility';\n  applicationStage = 'lead';\n}\n\nreturn {\n  json: {\n    ...$json,\n    status: finalDecision,\n    multipliedScore,\n    applicationStage\n  }\n};"
