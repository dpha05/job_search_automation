    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\n\nconst responsibilityScore = item.ai_responsibility_score;\nconst idealScoreCosine = item.ideal_score_cosine;\n\nconst weightResponsibility = 0.7;\nconst weightCosine = 0.3;\n\nconst finalWeightedScore = (responsibilityScore * weightResponsibility) + (idealScoreCosine * weightCosine);\n\nreturn {\n  final_weighted_score: finalWeightedScore,\n  responsibility_weighted: responsibilityScore * weightResponsibility,\n  ideal_cosine_weighted: idealScoreCosine * weightCosine\n};"
      },
