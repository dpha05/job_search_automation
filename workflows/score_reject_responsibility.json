      "id": "727a25b3-2004-476b-9fbe-89c2d1d266cc",
      "name": "Adjust score cosine"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM check_vibe(\n  '{{ $json.description_vector }}'::extensions.vector(1536),\n  'ideal_anchor'\n) AS ideal_score_cosine;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
