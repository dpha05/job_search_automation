          "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"is_ai_orchestration_heavy\": { \"type\": \"string\" },\n    \"is_ai_mentoring_heavy\": { \"type\": \"string\" },\n    \"is_ai_strategy_heavy\": { \"type\": \"string\" },\n    \"is_overqualified\": { \"type\": \"string\" }\n}\n}"
