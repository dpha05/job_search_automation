        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const data = $json.output; \nlet ai_responsibility_score = 1;\n\nif (data.is_overqualified === \"Yes\") {\n  ai_responsibility_score = 0;\n}\n\nelse if (data.is_ai_orchestration_heavy === \"No\" && data.is_ai_mentoring_heavy === \"No\" && data.is_ai_strategy_heavy === \"No\") {\n  ai_responsibility_score = 0;\n}\n\nreturn {\n  ai_responsibility_score\n};"
        },
